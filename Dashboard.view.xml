<!-- Save as  webapp/ext/view/Dashboard.view.xml  in the Manager app -->
<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:macros="sap.fe.macros"
          controllerName="managerdashboard.ext.view.Dashboard" displayBlock="true">
  <ScrollContainer height="100%" vertical="true">
    <VBox>
      <!-- 1. Filter bar (same fields as before: date, status, category, location, department) -->
      <macros:FilterBar id="FilterBar" contextPath="/AssetFacts"
                        metaPath="@com.sap.vocabularies.UI.v1.SelectionFields" />

      <!-- 2. KPI cards, between the filters and the chart -->
      <HBox class="kpiRow" wrap="Wrap">
        <VBox class="kpiCard kpiTotal">
          <Text text="Total assets" class="kpiTitle" />
          <Text text="{kpi>/total}" class="kpiValue" />
          <Text text="Across the selection" class="kpiNote" />
        </VBox>
        <VBox class="kpiCard kpiAvailable">
          <Text text="Available" class="kpiTitle" />
          <Text text="{kpi>/available}" class="kpiValue" />
          <Text text="{kpi>/pAvailable}% of selection" class="kpiNote" />
        </VBox>
        <VBox class="kpiCard kpiAssigned">
          <Text text="Assigned" class="kpiTitle" />
          <Text text="{kpi>/assigned}" class="kpiValue" />
          <Text text="{kpi>/pAssigned}% of selection" class="kpiNote" />
        </VBox>
        <VBox class="kpiCard kpiMaintenance">
          <Text text="In maintenance" class="kpiTitle" />
          <Text text="{kpi>/maintenance}" class="kpiValue" />
          <Text text="{kpi>/pMaintenance}% of selection" class="kpiNote" />
        </VBox>
        <VBox class="kpiCard kpiRetired">
          <Text text="Retired" class="kpiTitle" />
          <Text text="{kpi>/retired}" class="kpiValue" />
          <Text text="{kpi>/pRetired}% of selection" class="kpiNote" />
        </VBox>
      </HBox>

      <!-- 3. Status chart -->
      <macros:Chart id="Chart" contextPath="/AssetFacts" metaPath="@com.sap.vocabularies.UI.v1.Chart#Status"
                    filterBar="FilterBar" selectionMode="Multiple" />

      <!-- 4. Report buttons -->
      <Toolbar>
        <ToolbarSpacer />
        <Button text="Operational attention" press=".onAttention" />
        <Button text="Download PDF" type="Emphasized" press=".onDownloadPdf" />
        <Button text="Email Report" press=".onEmailReport" />
      </Toolbar>

      <!-- 5. Asset table -->
      <macros:Table id="Table" contextPath="/AssetFacts" metaPath="@com.sap.vocabularies.UI.v1.LineItem"
                    filterBar="FilterBar" type="ResponsiveTable" selectionMode="None" rowPress=".onRowPress" />
    </VBox>
  </ScrollContainer>
</mvc:View>
